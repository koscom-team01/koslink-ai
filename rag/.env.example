# ==============================================================================
# kosLINK AI - RAG 서버 환경변수 예시
# 실제 값은 .env 파일을 만들어 채운 뒤 사용하세요 (.env는 git에 커밋하지 않습니다)
# 로컬 개발 시 connect_db.sh 터널을 먼저 켠 상태여야 아래 localhost 값들로 접속됩니다.
# ==============================================================================

# PostgreSQL (RDBMS + pgvector 공용, koscomdb)
PG_CONNECTION_STRING=postgresql+psycopg://admin:adminpassword@localhost:5432/koscomdb

# Neo4j (온톨로지 GraphRAG 조회용)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# OpenAI API (LLM + 임베딩)
OPENAI_API_KEY=

# 금융감독원 Open DART API (shared/dart_client 사용 시 필요, https://opendart.fss.or.kr 에서 발급)
DART_API_KEY=
DART_CACHE_DIR=.cache/dart

# 임베딩 프로바이더 스위칭: openai | kure
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# kure는 embedding_server/ 로컬 Infinity 서버 폴백 경로에서만 사용 (docker-compose up embedding-server)
EMBEDDING_MODEL_KURE=nlpai-lab/KURE-v1
EMBEDDING_MODEL_BGE_M3=BAAI/bge-m3
EMBEDDING_SERVER_URL=http://localhost:7997
EMBEDDING_DEVICE=cpu

# 벡터 컬렉션 이름 (PGVector)
VECTOR_COLLECTION_NAME=market_evidence

# FastAPI 서버
PORT=8000
