# ==============================================================================
# kosLINK AI - 온톨로지(GraphRAG) 서버 환경변수 예시
# 실제 값은 .env 파일을 만들어 채운 뒤 사용하세요 (.env는 git에 커밋하지 않습니다)
# 로컬 개발 시 connect_db.sh 터널을 먼저 켠 상태여야 아래 localhost 값들로 접속됩니다.
# ==============================================================================

# Neo4j (온톨로지 GraphDB)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# 금융감독원 Open DART API (https://opendart.fss.or.kr 에서 발급)
DART_API_KEY=
DART_CACHE_DIR=.cache/dart

# Claude API (LLM 관계 추출용)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
